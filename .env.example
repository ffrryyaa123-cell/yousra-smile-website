# All provider secrets are server-only. Never prefix them with VITE_ and never
# paste real values into this example file or the browser UI.
OPENAI_API_KEY=""
OPENAI_AGENT_MODEL="gpt-5-mini"

# Optional legacy Gemini-backed routes. Leave empty when unused.
GEMINI_API_KEY=""

# Comma-separated, verified Firebase emails allowed to run review-only agents.
# The owner email is enforced separately by the server.
AGENT_EDITOR_EMAILS=""

# URL of the deployed server-side API. GitHub Pages hosts only the static client.
APP_URL=""
