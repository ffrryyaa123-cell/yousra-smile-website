# Gemini AI - server side only
GEMINI_API_KEY="replace_with_server_side_key"

# Public application URL
APP_URL="https://yousrasmile.com"

# Supabase public client configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="replace_with_publishable_key"
# Legacy fallback only, if your Supabase project still uses the older anon key name:
VITE_SUPABASE_ANON_KEY=""

# Supabase server-only configuration
SUPABASE_SERVICE_ROLE_KEY="replace_with_service_role_key"

# Authentication and encryption - generate locally with: npm run secrets:generate
SESSION_SECRET="replace_with_long_random_secret"
TOKEN_ENCRYPTION_KEY="replace_with_64_character_hex_key"
ADMIN_EMAIL="info@yousrasmile.com"
ADMIN_TEMP_PASSWORD="replace_with_generated_temporary_password"
ADMIN_BOOTSTRAP_TOKEN="replace_with_generated_bootstrap_token"
FORCE_ADMIN_PASSWORD_RESET="true"

# Official contact mailbox
CONTACT_EMAIL="info@yousrasmile.com"

# Social platform OAuth credentials - server side only
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
