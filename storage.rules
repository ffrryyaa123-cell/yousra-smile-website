rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return hasVerifiedEmail()
        && request.auth.token.email == 'sarsar336699@gmail.com';
    }

    function isStaff() {
      return hasVerifiedEmail()
        && request.auth.token.keys().hasAny(['role'])
        && request.auth.token.role in ['owner', 'editor'];
    }

    function canManageCatalog() {
      return isOwner() || isStaff();
    }

    function validVideoUpload() {
      return request.resource != null
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /products/{productId}/videos/{fileName} {
      allow read: if true;
      allow create, update: if canManageCatalog() && validVideoUpload();
      allow delete: if canManageCatalog();
    }

    match /products/{productId}/images/{fileName} {
      allow read: if true;
      allow create, update: if canManageCatalog() && validImageUpload();
      allow delete: if canManageCatalog();
    }
  }
}
