rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return hasVerifiedEmail()
        && request.auth.token.email == 'sarsar336699@gmail.com';
    }

    function isStaff() {
      return hasVerifiedEmail()
        && request.auth.token.keys().hasAny(['role'])
        && request.auth.token.role in ['owner', 'editor'];
    }

    function canManageCatalog() {
      return isOwner() || isStaff();
    }

    function documentIdMatches(documentId) {
      return request.resource.data.id == documentId;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if canManageCatalog() && documentIdMatches(productId);
      allow delete: if canManageCatalog();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update: if canManageCatalog() && documentIdMatches(videoId);
      allow delete: if canManageCatalog();
    }

    // Recovery safety net for the live catalog. The client may only append
    // snapshots before destructive actions; archived records cannot be edited
    // or deleted from the website client.
    match /catalog_delete_archive/{archiveId} {
      allow read: if canManageCatalog();
      allow create: if canManageCatalog()
        && request.resource.data.kind in ['products', 'videos']
        && request.resource.data.originalId is string
        && request.resource.data.archivedAt is string
        && request.resource.data.data is map;
      allow update, delete: if false;
    }
  }
}
