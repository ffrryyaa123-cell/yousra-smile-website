{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-ai-product-media-route.mjs && node scripts/patch-gemini-image-config.mjs && node scripts/patch-english-video-studio.mjs && tsx server.ts",
    "build": "node scripts/patch-ai-product-media-route.mjs && node scripts/patch-gemini-image-config.mjs && node scripts/patch-english-video-studio.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "validate:persistence": "node scripts/validate-persistence-config.mjs",
    "agent:pilot": "tsx agents/pilot.ts",
    "agent:validate": "tsx agents/validatePilot.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@openai/agents": "^0.15.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
